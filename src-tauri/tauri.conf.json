{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "StudHub Launcher",
  "version": "0.4.8",
  "identifier": "ru.studhub.launcher",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "StudHub Launcher",
        "width": 1280,
        "height": 820,
        "minWidth": 960,
        "minHeight": 660,
        "decorations": true,
        "backgroundColor": "#0c1019"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost data:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/icon.png",
      "icons/icon.ico",
      "icons/icon.icns"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "Russian",
          "English"
        ],
        "displayLanguageSelector": true
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    },
    "resources": {
      "resources/studhub-pack-1.0.2.zip": "resources/studhub-pack-1.0.2.zip"
    }
  }
}
